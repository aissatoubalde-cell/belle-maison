# Clé d'accès Web3Forms (créée pour l'adresse qui reçoit les demandes) : https://web3forms.com
# Transmise au navigateur du visiteur : l'envoi se fait directement depuis le site vers Web3Forms.
WEB3FORMS_ACCESS_KEY=votre_cle_web3forms

# URL publique du site (sans slash final), utilisée pour sitemap.xml, robots.txt et OpenGraph
NEXT_PUBLIC_SITE_URL=https://www.example.com
