# Clé API Resend (compte sur lequel le domaine bellemaison.africa est vérifié) : https://resend.com/api-keys
RESEND_API_KEY=re_votre_cle
# Expéditeur : une adresse du domaine vérifié sur Resend
CONTACT_FROM="Belle Maison Properties <site@bellemaison.africa>"
# Adresse qui reçoit les demandes de contact
CONTACT_TO=bellemaison.sa@gmail.com

# URL publique du site (sans slash final), utilisée pour sitemap.xml, robots.txt et OpenGraph
NEXT_PUBLIC_SITE_URL=https://www.bellemaison.africa
